  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "description": "The implemented primary action, with hover, focus, and disabled feedback.",
      "html": "<button class=\"ds-primary\" type=\"button\">حمّل التطبيق</button>",
      "css": ".ds-primary{font-family:Vamora,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:12px 24px;border-radius:8px;border:1px solid var(--line,#3e4540);font-size:15px;font-weight:700;text-decoration:none;cursor:pointer;transition:background .2s,color .2s;background:var(--lime,#c5f62f);color:var(--ink,#11170b);border-color:var(--lime,#c5f62f);}.ds-primary:hover{background:#d4ff53;}.ds-primary:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-danger,.ds-store,.ds-faq svg{transition:none}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "description": "The implemented ghost action, with hover, focus, and disabled feedback.",
      "html": "<button class=\"ds-ghost\" type=\"button\">إلغاء</button>",
      "css": ".ds-ghost{font-family:Vamora,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:12px 24px;border-radius:8px;border:1px solid var(--line,#3e4540);font-size:15px;font-weight:700;text-decoration:none;cursor:pointer;transition:background .2s,color .2s;background:transparent;color:var(--text,#f4f3ec);border-color:var(--line,#3e4540);}.ds-ghost:hover{background:var(--panel,#1b201e);}.ds-ghost:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}.ds-ghost:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-danger,.ds-store,.ds-faq svg{transition:none}}",
      "refersTo": "button-ghost"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "description": "The implemented danger action, with hover, focus, and disabled feedback.",
      "html": "<button class=\"ds-danger\" type=\"button\">احذف حسابي نهائيًا</button>",
      "css": ".ds-danger{font-family:Vamora,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:12px 24px;border-radius:8px;border:1px solid var(--line,#3e4540);font-size:15px;font-weight:700;text-decoration:none;cursor:pointer;transition:background .2s,color .2s;background:#b7352c;color:#fff;border-color:#b7352c;}.ds-danger:hover{background:#942c25;}.ds-danger:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}.ds-danger:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-danger,.ds-store,.ds-faq svg{transition:none}}",
      "refersTo": "button-danger"
    },
    {
      "name": "Store Link",
      "kind": "button",
      "description": "Two-line store action with inline mark; ordering remains LTR.",
      "html": "<a class=\"ds-store\" dir=\"ltr\" href=\"https://play.google.com/store/apps/details?id=com.vamora.fanasicomob\" aria-label=\"Get Vamora on Google Play\"><svg width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"m4 3 13 9L4 21V3Z\"/><path d=\"m17 12 3-2c1 .5 1 3 0 4l-3-2Z\"/></svg><span><small>متاح على</small><strong>Google Play</strong></span></a>",
      "css": ".ds-store{font-family:Vamora,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:14px;min-width:216px;height:68px;background:rgba(7,11,9,.91);border:1px solid var(--lime,#c5f62f);border-radius:12px;color:#fff;text-align:start;text-decoration:none;transition:background .2s,transform .2s}.ds-store small{display:block;font-size:12px;line-height:1.3}.ds-store strong{font-size:23px;font-weight:700;line-height:1.2}.ds-store:hover{background:#233019;transform:translateY(-2px)}.ds-store:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}@media(max-width:800px){.ds-store{min-width:165px;height:61px;gap:10px}.ds-store strong{font-size:19px}.ds-store small{font-size:11px}.ds-store svg{width:24px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-danger,.ds-store,.ds-faq svg{transition:none}}",
      "refersTo": "store-link"
    },
    {
      "name": "Form Field",
      "kind": "input",
      "description": "Visible label with LTR email value; focus and disabled styling match the account task.",
      "html": "<div class=\"ds-field\" dir=\"rtl\"><label for=\"ds-email\">البريد الإلكتروني</label><input id=\"ds-email\" type=\"email\" autocomplete=\"email\" dir=\"ltr\" placeholder=\"name@example.com\" required></div>",
      "css": ".ds-field{font-family:Vamora,sans-serif;color:var(--text,#f4f3ec);max-width:420px}.ds-field label{display:block;font-size:14px;font-weight:700;margin-bottom:8px}.ds-field input{font-family:Vamora,sans-serif;min-height:52px;width:100%;border:1px solid #667367;border-radius:8px;background:#101713;color:var(--text,#f4f3ec);padding:12px 16px;font-size:16px;caret-color:var(--lime,#c5f62f)}.ds-field input:focus{outline:2px solid var(--lime,#c5f62f);outline-offset:2px}.ds-field input:disabled{opacity:.6}",
      "refersTo": "form-input"
    },
    {
      "name": "Section Navigation",
      "kind": "nav",
      "description": "Desktop section anchors and persistent language action, with native direction and visible focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"التنقل الرئيسي\" dir=\"rtl\"><a href=\"#how-it-works\">كيف تلعب</a><a href=\"#features\">المميزات</a><a href=\"#faq\">الأسئلة الشائعة</a><a class=\"ds-language\" href=\"/en\" lang=\"en\" hreflang=\"en\" aria-label=\"View in English\">EN</a></nav>",
      "css": ".ds-nav{font-family:Vamora,sans-serif;display:flex;align-items:center;gap:44px;color:var(--text,#f4f3ec)}.ds-nav a{font-size:15px;white-space:nowrap;color:inherit;text-decoration:none;text-underline-offset:5px}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}.ds-nav .ds-language{min-width:44px;min-height:44px;padding:8px;display:grid;place-items:center}@media(max-width:1100px){.ds-nav{gap:20px}}"
    },
    {
      "name": "Competition Format Tab",
      "kind": "custom",
      "description": "Selected tab from the real roving-tab selector; runtime supplies selection and keyboard navigation.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"أنظمة المنافسات\" dir=\"rtl\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\">يوم كورة</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">دوري</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">كأس</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">مجموعات وإقصائيات</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;padding-bottom:16px;border-bottom:1px solid var(--line,#3e4540)}.ds-tabs button{font-family:Vamora,sans-serif;flex:1;background:transparent;border:0;color:var(--muted,#b7bdb7);padding:15px 18px;min-height:56px;font-size:17px;border-radius:8px;font-weight:700;cursor:pointer}.ds-tabs button[aria-selected=true]{background:var(--lime,#c5f62f);color:#17200b}.ds-tabs button:hover:not([aria-selected=true]){background:var(--panel,#1b201e);color:var(--text,#f4f3ec)}.ds-tabs button:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}@media(max-width:800px){.ds-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px}.ds-tabs button{font-size:15px;padding:12px 8px}}",
      "refersTo": "format-tab-selected"
    },
    {
      "name": "Editorial Format Panel",
      "kind": "card",
      "description": "Flat explanatory panel with a concise definition list and mobile stacking.",
      "html": "<article class=\"ds-panel\" dir=\"rtl\" tabindex=\"0\"><div><h3>يوم واحد. منافسة للآخر.</h3><p>حوّل حجز الكورة المعتاد لمنافسة.</p></div><dl><div><dt>مناسب لـ</dt><dd>حجز الكورة الجاي</dd></div><div><dt>اللاعبين بيتابعوا إيه</dt><dd>نتائج الماتشات ونقاط الفانتازي</dd></div></dl></article>",
      "css": ".ds-panel{font-family:Vamora,sans-serif;display:grid;grid-template-columns:1fr 1fr;gap:12%;background:var(--panel,#1b201e);color:var(--text,#f4f3ec);border-radius:12px;padding:44px}.ds-panel h3{font-size:30px;line-height:1.6;margin:0 0 16px}.ds-panel p{font-size:16px;line-height:1.9;color:var(--muted,#b7bdb7);margin:0}.ds-panel dl{margin:0;display:grid;gap:20px}.ds-panel dt{font-size:12px;color:var(--muted,#b7bdb7);margin-bottom:7px}.ds-panel dd{margin:0;font-size:16px}.ds-panel:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}@media(max-width:1000px){.ds-panel{gap:7%;padding:30px}}@media(max-width:800px){.ds-panel{grid-template-columns:1fr;gap:28px;padding:28px}.ds-panel h3{font-size:27px}.ds-panel dl{padding-top:24px;border-top:1px solid var(--line,#3e4540)}}",
      "refersTo": "format-panel"
    },
    {
      "name": "FAQ Disclosure",
      "kind": "custom",
      "description": "Native keyboard-operable disclosure with a rotating plus and a divider.",
      "html": "<details class=\"ds-faq\" dir=\"rtl\"><summary><span>إزاي أنضم لصحابي؟</span><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></summary><p>حمّل Vamora وافتح رابط الدعوة اللي المنظّم بعته.</p></details>",
      "css": ".ds-faq{font-family:Vamora,sans-serif;border-bottom:1px solid var(--line,#3e4540);color:var(--text,#f4f3ec)}.ds-faq summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 0;font-size:19px;line-height:1.7;cursor:pointer;font-weight:700}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary svg{color:var(--lime,#c5f62f);transition:transform .2s;flex-shrink:0}.ds-faq[open] summary svg{transform:rotate(45deg)}.ds-faq summary:focus-visible{outline:3px solid var(--lime,#c5f62f);outline-offset:5px;}.ds-faq p{padding:0 0 28px;margin:0;max-width:75ch;font-size:16px;line-height:1.9;color:var(--muted,#b7bdb7)}@media(max-width:800px){.ds-faq summary{font-size:17px;padding-block:22px}.ds-faq p{font-size:15px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-danger,.ds-store,.ds-faq svg{transition:none}}"
    },
